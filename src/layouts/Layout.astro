---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  section?: 'bodegas' | 'estacionamientos';
}

const { title, description = 'Inmobiliaria Lila - Bodegas y Estacionamientos en Santiago Centro', section } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | Inmobiliaria Lila</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <div class="header-inner">
          <a href="/" class="logo">
            <div class="logo-icon">🏠</div>
            Inmobiliaria <span class="text-orange">Lila</span>
          </a>
          <nav class="site-nav">
            <a href="/">Inicio</a>
            <a href="/bodegas">Bodegas</a>
            <a href="/estacionamientos">Estacionamientos</a>
          </nav>
          <div class="header-contact">
            <a href="https://wa.me/56932455405" target="_blank" class="btn-wa">
              <i class="fab fa-whatsapp"></i> WhatsApp
            </a>
          </div>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class={`footer-grid${section ? ' footer-grid--single' : ''}`}>

          <div class="footer-col footer-brand">
            <div class="footer-logo">
              <div class="logo-icon">🏠</div>
              Inmobiliaria Lila
            </div>
            <p>Soluciones de almacenamiento y estacionamiento en Santiago Centro.</p>
          </div>

          {(!section || section === 'estacionamientos') && (
          <div class="footer-col">
            <h4>Estacionamientos</h4>
            <ul>
              <li><a href="/estacionamientos">Ver planes</a></li>
              <li><a href="/plan-mensual">Plan Mensual</a></li>
              <li><a href="/plan-por-minuto">Plan Por Minuto</a></li>
              <li><a href="/estacionamientos#formulario">Solicitar información</a></li>
            </ul>
            <div class="footer-contact-info">
              <p><i class="fas fa-map-pin"></i>Rodulfo Phillipi 36, Santiago</p>
              <p><i class="fas fa-phone"></i><a href="tel:+56226899323">22 6899 323</a></p>
              <p><i class="fab fa-whatsapp"></i><a href="https://wa.me/56920405954" target="_blank">+56 9 2040 5954</a></p>
              <p><i class="fas fa-envelope"></i><a href="mailto:estacionamientoslila@gmail.com">estacionamientoslila@gmail.com</a></p>
            </div>
          </div>
          )}

          {(!section || section === 'bodegas') && (
          <div class="footer-col">
            <h4>Bodegas</h4>
            <ul>
              <li><a href="/bodegas">Ver bodegas disponibles</a></li>
              <li><a href="/bodegas#formulario">Solicitar cotización</a></li>
              <li><a href="/bodegas#ubicaciones">Ubicaciones</a></li>
            </ul>
            <div class="footer-contact-info">
              <p><i class="fas fa-map-pin"></i>Almirante Churruca 3181, Santiago</p>
              <p><i class="fas fa-map-pin"></i>Avda. Buzeta 3558, Estación Central</p>
              <p><i class="fas fa-phone"></i><a href="tel:+56932455405">+56 9 3245 5405</a></p>
              <p><i class="fab fa-whatsapp"></i><a href="https://wa.me/56932455405" target="_blank">+56 9 3245 5405</a></p>
              <p><i class="fas fa-envelope"></i><a href="mailto:bodegasbuzeta@gmail.com">bodegasbuzeta@gmail.com</a></p>
            </div>
          </div>
          )}

        </div>
        <div class="footer-bottom">
          <p>&copy; 2026 Inmobiliaria Lila. Todos los derechos reservados.</p>
        </div>
      </div>
    </footer>

    <style>
      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
    </style>
  </body>
</html>
