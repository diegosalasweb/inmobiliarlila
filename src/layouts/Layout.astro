---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  section?: 'bodegas' | 'estacionamientos';
}

const { title, description = 'Inmobiliaria Lila - Bodegas y Estacionamientos en Santiago Centro', section } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | Inmobiliaria Lila</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-422L615VKD"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-422L615VKD');
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <div class="header-inner">
          <a href="/" class="logo">
            <div class="logo-icon">🏠</div>
            Inmobiliaria <span class="text-orange">Lila</span>
          </a>
          <nav class="site-nav">
            <a href="/">Inicio</a>
            <a href="/bodegas">Bodegas</a>
            <a href="/estacionamientos">Estacionamientos</a>
          </nav>
          <div class="header-contact" id="header-wa-container">
            <!-- WhatsApp dinámico según página -->
          </div>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class={`footer-grid${section ? ' footer-grid--single' : ''}`}>

          <div class="footer-col footer-brand">
            <div class="footer-logo">
              <div class="logo-icon">🏠</div>
              Inmobiliaria Lila
            </div>
            <p>Soluciones de almacenamiento y estacionamiento en Santiago Centro.</p>
          </div>

          {(!section || section === 'estacionamientos') && (
          <div class="footer-col">
            <h4>Estacionamientos</h4>
            <ul>
              <li><a href="/estacionamientos">Ver planes</a></li>
              <li><a href="/plan-mensual">Plan Mensual</a></li>
              <li><a href="/plan-por-minuto">Plan Por Minuto</a></li>
              <li><a href="/estacionamientos#formulario">Solicitar información</a></li>
            </ul>
            <div class="footer-contact-info">
              <p><i class="fas fa-map-pin"></i>Rodulfo Phillipi 36, Santiago</p>
              <p><i class="fas fa-phone"></i><a href="tel:+56226899323">22 6899 323</a></p>
              <p><i class="fab fa-whatsapp"></i><a href="https://wa.me/56920405954" target="_blank">+56 9 2040 5954</a></p>
              <p><i class="fas fa-envelope"></i><a href="mailto:estacionamientoslila@gmail.com">estacionamientoslila@gmail.com</a></p>
            </div>
          </div>
          )}

          {(!section || section === 'bodegas') && (
          <div class="footer-col">
            <h4>Bodegas</h4>
            <ul>
              <li><a href="/bodegas">Ver bodegas disponibles</a></li>
              <li><a href="/bodegas#formulario">Solicitar cotización</a></li>
              <li><a href="/bodegas#ubicaciones">Ubicaciones</a></li>
            </ul>
            <div class="footer-contact-info">
              <p><i class="fas fa-map-pin"></i>Almirante Churruca 3181, Santiago</p>
              <p><i class="fas fa-map-pin"></i>Avda. Buzeta 3558, Estación Central</p>
              <p><i class="fas fa-phone"></i><a href="tel:+56932455405">+56 9 3245 5405</a></p>
              <p><i class="fab fa-whatsapp"></i><a href="https://wa.me/56932455405" target="_blank">+56 9 3245 5405</a></p>
              <p><i class="fas fa-envelope"></i><a href="mailto:bodegasbuzeta@gmail.com">bodegasbuzeta@gmail.com</a></p>
            </div>
          </div>
          )}

        </div>
        <div class="footer-bottom">
          <p>&copy; 2026 Inmobiliaria Lila. Todos los derechos reservados.</p>
        </div>
      </div>
    </footer>

    <style>
      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
    </style>

    <style is:global>
      .header-wa-group {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        align-items: center;
      }

      .btn-wa {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        background: #25D366;
        color: white;
        text-decoration: none;
        border-radius: 6px;
        font-size: 0.9rem;
        white-space: nowrap;
        transition: background 0.3s ease;
      }

      .btn-wa:hover {
        background: #1eaa50;
      }

      @media (max-width: 768px) {
        .header-wa-group {
          flex-direction: column;
          gap: 0.5rem;
        }

        .btn-wa {
          width: 100%;
          justify-content: center;
        }
      }
    </style>

    <script>
      (function() {
        var path = window.location.pathname;
        var container = document.getElementById('header-wa-container');
        if (!container) return;

        var WA_BODEGAS = 'https://wa.me/56932455405';
        var WA_ESTAC  = 'https://wa.me/56920405954';

        var btnBodegas = '<a href="' + WA_BODEGAS + '" target="_blank" class="btn-wa"><i class="fab fa-whatsapp"></i> Bodegas</a>';
        var btnEstac   = '<a href="' + WA_ESTAC  + '" target="_blank" class="btn-wa"><i class="fab fa-whatsapp"></i> Estacionamientos</a>';

        if (path === '/' || path === '') {
          container.innerHTML = '<div class="header-wa-group">' + btnBodegas + btnEstac + '</div>';
        } else if (path.startsWith('/bodegas')) {
          container.innerHTML = btnBodegas;
        } else {
          // /estacionamientos, /plan-mensual, /plan-por-minuto y cualquier otra
          container.innerHTML = btnEstac;
        }
      })();
    </script>
  </body>
</html>
