---
interface Location {
  address: string;
  title?: string;
}

interface Props {
  locations: Location[];
  title?: string;
}

const { locations, title = 'Dónde Encontrarnos' } = Astro.props;

function buildMapUrl(address: string): string {
  const encoded = encodeURIComponent(address + ', Chile');
  return `https://maps.google.com/maps?q=${encoded}&output=embed&hl=es&z=16`;
}

const isSingle = locations.length === 1;
---

<section class="map-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{title}</h2>
    </div>

    <div class={`map-grid ${isSingle ? 'map-grid--single' : 'map-grid--multi'}`}>
      {locations.map((loc) => (
        <div class="map-card">
          {loc.title && (
            <div class="map-card-header">
              <span class="map-pin-icon"><i class="fas fa-map-pin"></i></span>
              <div>
                <p class="map-card-title">{loc.title}</p>
                <p class="map-card-address">{loc.address}</p>
              </div>
            </div>
          )}
          {!loc.title && (
            <div class="map-card-header">
              <span class="map-pin-icon"><i class="fas fa-map-pin"></i></span>
              <p class="map-card-address">{loc.address}</p>
            </div>
          )}
          <div class="map-embed-wrapper">
            <iframe
              src={buildMapUrl(loc.address)}
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title={`Mapa de ${loc.title ?? loc.address}`}
            ></iframe>
          </div>
          <a
            href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(loc.address + ', Chile')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="map-open-link"
          >
            Ver en Google Maps →
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .map-section {
    padding: 64px 0;
    background: var(--gray-bg, #f8f8f6);
  }

  .map-grid {
    display: grid;
    gap: 28px;
  }

  .map-grid--single {
    grid-template-columns: 1fr;
    max-width: 800px;
    margin: 0 auto;
  }

  .map-grid--multi {
    grid-template-columns: repeat(2, 1fr);
  }

  @media (max-width: 768px) {
    .map-grid--multi {
      grid-template-columns: 1fr;
    }
  }

  .map-card {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.2s ease;
  }

  .map-card:hover {
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.13);
  }

  .map-card-header {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 20px 20px 16px;
    border-bottom: 1px solid var(--border, #e8e8e4);
  }

  .map-pin-icon {
    font-size: 1.4rem;
    line-height: 1;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .map-card-title {
    font-weight: 700;
    font-size: 1rem;
    color: var(--gray, #2c2c2c);
    margin: 0 0 4px;
    line-height: 1.3;
  }

  .map-card-address {
    font-size: 0.9rem;
    color: var(--gray-mid, #666);
    margin: 0;
    line-height: 1.4;
  }

  .map-embed-wrapper {
    width: 100%;
    height: 320px;
    flex-shrink: 0;
  }

  .map-embed-wrapper iframe {
    display: block;
    width: 100%;
    height: 100%;
  }

  .map-open-link {
    display: block;
    text-align: center;
    padding: 14px 20px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--orange, #E67E22);
    text-decoration: none;
    border-top: 1px solid var(--border, #e8e8e4);
    transition: background 0.15s ease, color 0.15s ease;
  }

  .map-open-link:hover {
    background: var(--orange-light, #fff3e8);
    color: var(--orange-dark, #cf6d17);
  }
</style>
