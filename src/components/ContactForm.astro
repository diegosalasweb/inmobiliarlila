---
interface Props {
  productType: 'bodegas' | 'estacionamientos';
}

const { productType } = Astro.props;

const formConfig = {
  bodegas: {
    email: 'bodegasbuzeta@gmail.com',
    whatsapp: '56932455405',
    title: 'Solicitar Cotización de Bodega',
    submitText: 'Solicitar Cotización'
  },
  estacionamientos: {
    email: 'estacionamientoslila@gmail.com',
    whatsapp: '56932455405',
    title: 'Contactar para Estacionamiento',
    submitText: 'Enviar Consulta'
  }
};

const config = formConfig[productType];
---

<section class="form-section" id="formulario">
  <div class="container">
    <div class="form-wrapper">
      <h2 class="form-title">{config.title}</h2>
      <p class="form-subtitle">Completa el formulario y te contactamos a la brevedad.</p>

      <div id="form-success" class="form-success">
        <div class="ic"><i class="fas fa-check-circle"></i></div>
        <h3>¡Consulta recibida!</h3>
        <p>Gracias por contactarnos. Nos comunicaremos contigo a la brevedad.</p>
      </div>

      <form id="contact-form">
        <div class="form-group">
          <label for="name">Nombre *</label>
          <input type="text" id="name" name="name" placeholder="Tu nombre completo" required />
        </div>

        <div class="form-group">
          <label for="email">Email *</label>
          <input type="email" id="email" name="email" placeholder="tu@email.com" required />
        </div>

        <div class="form-group">
          <label for="phone">Teléfono / WhatsApp *</label>
          <input type="tel" id="phone" name="phone" placeholder="+56 9 XXXX XXXX" required />
        </div>

        <div class="form-group">
          <label for="product">Producto de interés *</label>
          <select id="product" name="product" required>
            <option value="">Selecciona una opción</option>
            {productType === 'bodegas' && (
              <>
                <option value="bodega-pequena">Bodega Pequeña (100–250 m²)</option>
                <option value="bodega-mediana">Bodega Mediana (250–500 m²)</option>
                <option value="bodega-grande">Bodega Grande (500 m²+)</option>
                <option value="consulta-general">Consulta General</option>
              </>
            )}
            {productType === 'estacionamientos' && (
              <>
                <option value="mensual">Plan Mensual</option>
                <option value="por-minuto">Estacionamiento por Minuto</option>
                <option value="consulta">Consulta General</option>
              </>
            )}
          </select>
        </div>

        <div class="form-group">
          <label for="message">Mensaje (opcional)</label>
          <textarea id="message" name="message" placeholder="Cuéntanos más sobre lo que necesitas..."></textarea>
        </div>

        <button type="submit" class="btn btn-primary btn-lg form-submit">
          {config.submitText}
        </button>
      </form>

      <div class="form-contact-links">
        <p style="width:100%; text-align:center; color:var(--gray-mid); font-size:0.9rem; margin-bottom:4px;">¿Prefieres contactar directamente?</p>
        <a href={`https://wa.me/${config.whatsapp}`} target="_blank" class="form-contact-link wa">
          <i class="fab fa-whatsapp" style="margin-right:0.35rem"></i>WhatsApp
        </a>
        <a href={`tel:+${config.whatsapp}`} class="form-contact-link tel">
          <i class="fas fa-phone" style="margin-right:0.35rem"></i>Llamar
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbzR0G0QTLdjpTAIIXzjbuflSEgO6rYfOUYIftiVPOpBBopUDSwZYqffQhprnPzR_3c0IQ/exec';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const success = document.getElementById('form-success') as HTMLDivElement;
  const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;
  const submitBtnDefaultText = submitBtn?.textContent ?? '';

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const data = {
        name:      formData.get('name'),
        email:     formData.get('email'),
        phone:     formData.get('phone'),
        product:   formData.get('product'),
        message:   formData.get('message'),
        timestamp: new Date().toISOString(),
        page:      window.location.pathname,
      };

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Enviando...';
      }

      try {
        // Content-Type text/plain evita el preflight CORS que Apps Script no maneja;
        // doPost igual parsea el body como JSON.
        await fetch(SCRIPT_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(data),
        });

        form.style.display = 'none';
        if (success) success.style.display = 'block';

        const gtag = (window as any).gtag;
        if (typeof gtag === 'function') {
          gtag('event', 'conversion', {
            'allow_custom_events': true,
            'value': 1.0,
            'currency': 'CLP',
          });
        }
      } catch (err) {
        console.error('Error al enviar el formulario:', err);
        alert('Hubo un problema al enviar tu consulta. Intenta nuevamente o contáctanos por WhatsApp.');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = submitBtnDefaultText;
        }
      }
    });
  }
</script>
